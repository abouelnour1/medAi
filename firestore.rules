rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }
    function isCompany() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'company';
    }

    // ── الداتا الرئيسية — أدمن بس ────────────────────────────────
    // المستخدمين العاديين بياخدوا من Storage مش من هنا
    match /medicines/{document=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /supplements/{document=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /food/{document=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── app_meta — الكل يقرأ الـ timestamp (1 read عند كل فتح) ──
    // مهم عشان المستخدمين يعرفوا لو في تحديث جديد
    match /app_meta/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── المستخدمين ───────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ── طلبات التحديث ────────────────────────────────────────────
    match /pending_updates/{document=**} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── الإعدادات ─────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── الإشعارات ─────────────────────────────────────────────────
    match /notifications/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── البيانات السريرية ─────────────────────────────────────────
    match /clinicalData/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── المميز اليومي ─────────────────────────────────────────────
    match /dailyFeatured/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /featuredSchedule/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
