rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }

    function isCompany() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'company';
    }

    // ─── الأدوية ──────────────────────────────────────────────
    match /medicines/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── المكملات الغذائية ────────────────────────────────────
    match /supplements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── الفود ───────────────────────────────────────────────
    match /food/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── metadata إصدار الداتا ────────────────────────────────
    match /app_meta/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── المستخدمين ───────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      // المستخدم يعدل بياناته، والأدمن يعدل أي حساب
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ─── الطلبات المعلقة ──────────────────────────────────────
    match /pending_updates/{document=**} {
      allow read:  if request.auth != null;
      allow create: if request.auth != null;
      // بس الأدمن يقدر يعدل أو يحذف
      allow update, delete: if isAdmin();
    }

    // ─── الإعدادات ────────────────────────────────────────────
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── الإشعارات ────────────────────────────────────────────
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── المعلومات السريرية ───────────────────────────────────
    match /clinicalData/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── أدوية اليوم المميزة ──────────────────────────────────
    match /dailyFeatured/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── جدول أدوية اليوم ────────────────────────────────────
    match /featuredSchedule/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
