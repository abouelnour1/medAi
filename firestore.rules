rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
             request.auth.token.email == 'aboelnour1212@gmail.com';
    }

    // ── التعديلات — الكل يقرأ، أدمن بس يكتب ─────────────────────
    match /medicine_overrides/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── app_meta — الكل يقرأ الـ timestamp ───────────────────────
    match /app_meta/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── المستخدمين ───────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isLoggedIn();
      allow write: if (isLoggedIn() && request.auth.uid == userId) || isAdmin();
    }

    // ── إشعارات كل مستخدم (subcollection) ───────────────────────
    match /users/{userId}/notifications/{notifId} {
      allow read:  if isLoggedIn() && request.auth.uid == userId;
      allow write: if false; // Cloud Functions Admin SDK فقط
    }

    // ── طلبات التحديث (Company) ───────────────────────────────────
    match /pending_updates/{document=**} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── الإعدادات ─────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── الإشعارات ─────────────────────────────────────────────────
    match /notifications/{document=**} {
      allow read:  if true;
      allow write: if isLoggedIn();
    }

    // ── سجل الإشعارات المرسلة (Cloud Functions فقط) ──────────────
    match /notifications_log/{document=**} {
      allow read:  if isAdmin();
      allow write: if false; // Cloud Functions Admin SDK bypasses rules
    }

    // ── البيانات السريرية ─────────────────────────────────────────
    match /clinicalData/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── المميز اليومي ─────────────────────────────────────────────
    match /dailyFeatured/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /featuredSchedule/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
