
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح لأي مستخدم مسجل بقراءة وكتابة بياناته الخاصة فقط
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // السماح للمشرفين بقراءة كل المستخدمين
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // السماح للجميع بقراءة قائمة مستحضرات التجميل، والكتابة للمشرفين فقط
    match /cosmetics/{cosmeticId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // السماح للمشرفين بإدارة الأدوية والتأمين إذا كانت في السحابة
    match /medicines/{medId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /insurance/{insId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
