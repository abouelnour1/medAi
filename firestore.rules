rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper - هل المستخدم أدمن؟
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── الأدوية ───────────────────────────────────────────────
    match /medicines/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── التجميل ───────────────────────────────────────────────
    match /cosmetics/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company'
      );
    }

    // ─── المستخدمين ────────────────────────────────────────────
    match /users/{userId} {
      // قراءة: أي مستخدم مسجل يقدر يقرأ (للبحث في المستخدمين)
      allow read:  if request.auth != null;
      // كتابة: كل مستخدم يكتب بياناته بس، أو الأدمن
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ─── الطلبات المعلقة ───────────────────────────────────────
    match /pending_updates/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ─── الإعدادات ─────────────────────────────────────────────
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── الإشعارات ─────────────────────────────────────────────
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── المعلومات السريرية لأدوية اليوم ──────────────────────
    // قراءة للكل، كتابة للأدمن فقط
    match /clinicalData/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── أدوية اليوم المميزة ───────────────────────────────────
    // قراءة للكل، كتابة للأدمن فقط
    match /dailyFeatured/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── جدول أدوية اليوم ──────────────────────────────────────
    // قراءة للكل، كتابة للأدمن فقط
    match /featuredSchedule/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
