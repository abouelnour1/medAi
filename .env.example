# PharmaSource KSA - Environment Variables
# ============================================

# URL الـ Vercel الخاص بيك - مهم للـ Android
# مثال: https://pharmasource-ksa.vercel.app/api/gemini
VITE_PROXY_URL=https://YOUR_APP_NAME.vercel.app/api/gemini

# VAPID key للإشعارات على الويب (اختياري)
VITE_VAPID_KEY=your_vapid_key_here

# ملاحظة: الـ Gemini API key بيتحط على Vercel مش هنا
# Vercel Dashboard → Settings → Environment Variables → VITE_API_KEY
