# ══════════════════════════════════════════════════════
# PharmaSource — Environment Variables
# ══════════════════════════════════════════════════════
#
# انسخ الملف ده وسميه .env.local
# ماترفعوش على GitHub أبداً!
#
# ── للويب (Vercel) ─────────────────────────────────
# حط الـ API key في Vercel Dashboard فقط:
# Settings → Environment Variables → GEMINI_API_KEY
# (مش هنا — هنا للـ local development بس)
#
GEMINI_API_KEY=your_gemini_api_key_here

# ── للأندرويد ──────────────────────────────────────
# بعد ما ترفع على Vercel، حط الـ URL هنا:
VITE_PROXY_URL=https://your-app.vercel.app/api/gemini

# ── Firebase ───────────────────────────────────────
VITE_FIREBASE_PROJECT_ID=medainew-fa6a2
